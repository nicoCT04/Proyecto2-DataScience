# ------------------------------------------------------------
# Entornos virtuales (cada quien lo regenera con requirements.txt)
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# ------------------------------------------------------------
# Videos: NO se versionan (~3.8 GB). Se re-descargan desde el
# dataset de Hugging Face con src/download_clips.sh. Los CSV
# de anotaciones e inventario sí se conservan.
# ------------------------------------------------------------
data/clips/
*.mp4

# Subclips etiquetados (~4.6 GB), se descargan con src/download_subclips.sh
data/subclips/

# Frames extraidos (reproducibles a partir de los clips)
data/frames/

# Pesos preentrenados (se descargan solos: yolov8n y resnet18 desde Hugging Face).
# Los modelos entrenados por nosotros (models/*.joblib, models/gru.pt) sí se versionan
# porque la app los necesita.
models/pretrained/
*.pt
!models/gru.pt

# HTML exportado de los notebooks (reproducible con nbconvert)
docs/html/

# ------------------------------------------------------------
# Sistema operativo / editores
# ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ------------------------------------------------------------
# Secretos
# ------------------------------------------------------------
.env
.env.*

# Videos de ejemplo para la app (4 subclips de prueba, ~15 MB)
!app/samples/*.mp4

# Configuración local de Claude Code
.claude/
